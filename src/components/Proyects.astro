<style>
    .proyects {
        width: 100%;
        height: auto;
    }
    .title-proyects,
    .subtitle-proyects {
        text-align: center;
    }

    .title-proyects {
        font-size: 3rem;
        font-weight: 600;
        margin-bottom: 2rem;
        padding-top: 1em;
    }

    .subtitle-proyects {
        margin-bottom: 5rem;
    }
    .container-proyects {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .container-proyects:not(:last-child) {
        margin-bottom: 10em;
    }

    .container-img {
        width: 50%;
    }

    .container-text {
        width: 50%;
    }

    .title-proyect {
        font-size: 2em;
        font-weight: 600;
        margin-bottom: 1em;
    }

    .subtitle-proyect {
        font-size: 1em;
        margin-bottom: 1em;
    }

    .techonologies-text {
        font-weight: 600;
        margin-bottom: 3em;
    }

    .container-technologies {
        display: flex;
        gap: 1em;
        margin-block: 2em;
    }

    .technologie {
        display: flex;
        border: 1px solid orangered;
        background-color: orange;
        width: auto;
        border-radius: 50px;
        padding: 0.2em 0.5em;
    }

    .technologie-img {
        width: 20px;
    }

    .container-buttons {
        display: flex;
        gap: 1em;
    }

    @media (max-width: 880px) {
        .title-proyects {
            margin-top: 2em;
        }
        .subtitle-proyects {
        margin-bottom: 2em;
        }
        .container-proyects:not(:last-child) {
            margin-bottom: 7em;
        }
        .container-proyects {
            flex-direction: column;
        }
        .container-img {
            width: 100%;
        }

        .container-text {
            width: 100%;
            text-align: center;
        }
        .container-technologies {
            justify-content: center;
        }
        .container-buttons {
            flex-direction: column;
            align-items: center;        }
    }
</style>
