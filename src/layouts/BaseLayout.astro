---
import Header from "@/components/Header.astro"
const { title, description, keywords } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <style>
            /* Critical CSS: https://midu.dev/como-extraer-el-critical-css-con-puppeteer/ */
        </style>
        <meta name="keywords" content={keywords} />
        <meta name="description" content={description}>
        <meta name="author" content="Brian Exequiel" />
        <meta name="copyright" content="Brian Exequiel" />
        <meta name="robots" content="index, follow" />
        <!-- Favicons para todos los dispositivos -->
        <!-- https://www.favicon-generator.org/ --> 
        <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />
        <link rel="stylesheet" href="/src/styles/global.css" />
        <meta name="theme-color" content="#4285f4">
        <meta name="mobile-web-app-capable" content="yes">
        <!-- https://metatags.io/ y https://www.opengraph.xyz/-->
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
        <Header />
        <main>
            <slot />
        </main>
	</body>
</html>